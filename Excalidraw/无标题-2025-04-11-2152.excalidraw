    {
      "id": "lyL472rtbXj8sTP_57fZu",
      "type": "text",
      "x": -614.4580002881879,
      "y": 3960.955246390186,
      "width": 698.1408353627986,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
