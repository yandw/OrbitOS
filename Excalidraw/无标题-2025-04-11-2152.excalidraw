      "lineHeight": 1.25
    },
    {
      "id": "SuYqYqDutpliOrVHeWgGj",
      "type": "text",
      "x": -1198.6018736197898,
      "y": 10433.422587247975,
      "width": 238.60124364472082,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bS7",
      "roundness": null,
      "seed": 492382842,
      "version": 306,
      "versionNonce": 2070143354,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752496508056,
      "link": null,
      "locked": false,
      "text": "建筑领域：重点商业楼宇（如港\n汇恒隆、光大会展等）逐时用电\n数据、BMS后台数据及物业能耗\n账单\n交通领域：交通卡口视频流量分\n析数据、公共交通运营数据、网\n约车平台订单数据。",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "建筑领域：重点商业楼宇（如港汇恒隆、光大会展等）逐时用电数据、BMS后台数据及物业能耗账单\n交通领域：交通卡口视频流量分析数据、公共交通运营数据、网约车平台订单数据。",
      "autoResize": false,
      "lineHeight": 1.25
    },
